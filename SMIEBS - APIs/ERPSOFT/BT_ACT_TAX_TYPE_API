----    Lead Header API
---------------------------------------------------------------------------------------------------------------------------------
create or replace PROCEDURE   BT_ACD_TAX_TYPE_API
    (       p_return_code                   OUT  VARCHAR2,
            p_return_message                OUT  VARCHAR2,
            p_action                        IN   VARCHAR2,
            p_user_id                       IN   NUMBER,
            p_start_date                    IN   DATE,
            p_end_date                      IN   DATE,
            p_client_id                     IN   NUMBER,
            p_tax_type_id                   IN   NUMBER,
            p_tax_type_code                 IN   VARCHAR2,
            p_tax_type_name                 IN   VARCHAR2,
            p_description                   IN   VARCHAR2,
            p_recoverable_flag              IN   VARCHAR2,
            p_offset_flag                   IN   VARCHAR2,
            p_self_assesed_flag             IN   VARCHAR2,
            p_allow_abatement               IN   VARCHAR2,
            p_tax_point_basis               IN   VARCHAR2,
            p_update_party_on_transaction   IN   VARCHAR2,
            p_regime_id                     IN   NUMBER
    )

    AS

----    Declare Variables and Cursors required for generation
        err_message           varchar2(200) := null;
        exists_flag           varchar2(01)  := null;
        dummy_flag            varchar2(01)  := null;
        recs_added            number        := 0;

        Some_Error            EXCEPTION;

BEGIN
        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,'Execution Started for Maintaining Tax Type Master');
        DBMS_OUTPUT.put_line ('Execution Started for Maintaining Tax Type Master');

----    Start of Maintaining Tax Type Master
        p_return_code          := 0;                      ----  Successful Execution
        p_return_message       := ' '; 

----    First check the mode of operations
        CASE  upper(p_action)
        WHEN  'I'   THEN  null;
        WHEN  'A'   THEN  null;
        WHEN  'C'   THEN  null;
        WHEN  'U'   THEN  null;
        ELSE  p_return_code     := 2;
              p_return_message  := 'Invalid Action Passed - '||p_action; 
        END   CASE;

----    Check the mode of operations and passed Tax Type id
        IF    ( upper(p_action) in ('I','A','C') AND p_tax_type_id is not null) 
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid Combination of action and Tax Type ID';
        END   IF;

        IF    ( upper(p_action) in ('U') AND p_tax_type_id is null) 
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid Combination of action and Tax Type ID';
        END   IF;

----    Validate Start and End Date
        IF    ((p_end_date is not null)  and  (p_end_date < p_start_date))
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'End Date must be greater or equal to Start Date';
        END   IF;

----    Validate Client ID
        BEGIN  
                SELECT  'Y'
                INTO    exists_flag
                FROM    cmn_client_master
                WHERE   client_id   =  p_client_id;
        EXCEPTION
                WHEN    NO_DATA_FOUND
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid Client ID Passed';
                WHEN    OTHERS
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid Client ID Passed';
        END;

----    Validate Tax Type Code
        IF    (p_tax_type_code is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Tax Type Code should not be null';
        END   IF;

----    Validate Tax Type Name
        IF    (p_tax_type_name is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Tax Type Name should not be null';
        END   IF;

----    Validate Recoverable Flag
        IF    (p_recoverable_flag is null)
        THEN  p_return_code     :=  2;
              p_return_message  :=  p_return_message ||  ' - '  ||
                                    'Recoverable Flag should not be null';
        END   IF;

----    Validate Offset Flag
        IF    (p_offset_flag is null)
        THEN  p_return_code     :=  2;
              p_return_message  :=  p_return_message ||  ' - '  ||
                                    'Offset Flag should not be null';
        END   IF;

----    Validate Self Assesed Flag
        IF    (p_self_assesed_flag is null)
        THEN  p_return_code     :=  2;
              p_return_message  :=  p_return_message ||  ' - '  ||
                                    'Self Assesed Flag should not be null';
        END   IF;

----    Validate Allow Abatement
        IF    (p_allow_abatement is null)
        THEN  p_return_code     :=  2;
              p_return_message  :=  p_return_message ||  ' - '  ||
                                    'Allow Abatement should not be null';
        END   IF;

/*
----    Validate Tax Point Basis
        IF    (p_tax_point_basis is null)
        THEN  p_return_code     :=  2;
              p_return_message  :=  p_return_message ||  ' - '  ||
                                    'Tax Point Basis should not be null';
        END   IF;
*/
----    Validate Regime ID
        BEGIN  
                SELECT  'Y'
                INTO    exists_flag
                FROM    bt_regime_master_v
                WHERE   regime_id           =  p_regime_id
                AND     client_id           =  p_client_id;
        EXCEPTION
                WHEN    NO_DATA_FOUND
                THEN    p_return_code      := 2;
                        p_return_message   := p_return_message || ' - ' ||
                                             'Invalid Regime ID Passed';
                WHEN    OTHERS
                THEN    p_return_code      := 2;
                        p_return_message   := p_return_message || ' - ' ||
                                             'Invalid Regime ID Passed';
        END;

----    Verify if thre is an error, if yes then raise exception and exit out
        IF    ( p_return_code <> 0)
        THEN  raise  Some_Error;
        END   IF;

----    Take Action according to p_action variable
        IF    ( upper(p_action) in ('I','A','C')) 
        THEN
              BEGIN
                    INSERT INTO bt_tax_type_master
                    (   CREATION_DATE,
                        CREATED_BY,
                        LAST_UPDATE_DATE,
                        LAST_UPDATED_BY,
                        START_DATE,
                        END_DATE,
                        CLIENT_ID,
                        TAX_TYPE_ID,
                        TAX_TYPE_CODE,
                        TAX_TYPE_NAME,
                        DESCRIPTION,
                        RECOVERABLE_FLAG,
                        OFFSET_FLAG,
                        SELF_ASSESED_FLAG,
                        ALLOW_ABATEMENT,
                        TAX_POINT_BASIS,
                        UPDATE_PARTY_ON_TRANSACTION,
                        REGIME_ID
                    )
                    VALUES
                    (   sysdate,
                        p_USER_ID,
                        sysdate,
                        p_USER_ID,
                        sysdate,
                        null,
                        p_client_id,
                        bt_tax_type_seq.nextval,
                        p_tax_type_code,
                        p_tax_type_name,
                        p_description,
                        p_recoverable_flag,
                        p_offset_flag,
                        p_self_assesed_flag,
                        p_allow_abatement,
                        p_tax_point_basis,
                        p_update_party_on_transaction,
                        p_regime_id
                    );
                    commit;
            EXCEPTION
                WHEN    OTHERS
                THEN    p_return_code      :=  2;
                        p_return_message   :=  p_return_message ||  ' - '  ||
                                               'Unable to create Record';
                        raise  Some_Error;
                        RETURN;
                END; 
        ELSE
                BEGIN
                        UPDATE  bt_tax_type_master 
                        SET     last_update_date              =  sysdate,
                                last_updated_by               =  p_USER_ID,
                                start_date                    =  p_start_date,
                                end_date                      =  p_end_date,
                                client_id                     =  p_client_id,
                                tax_type_name                 =  p_tax_type_name,
                                description                   =  p_description,
                                recoverable_flag              =  p_recoverable_flag,
                                offset_flag                   =  p_offset_flag,
                                self_assesed_flag             =  p_self_assesed_flag,
                                allow_abatement               =  p_allow_abatement,
                                tax_point_basis               =  p_tax_point_basis,
                                update_party_on_transaction   =  p_update_party_on_transaction,
                                regime_id                     =  p_regime_id
                        WHERE   1                             =  1
                        AND     tax_type_id                   =  p_tax_type_id;
                        commit;
                EXCEPTION
                        WHEN    OTHERS
                        THEN    p_return_code                :=  2;
                                p_return_message             :=  p_return_message ||  ' - '  ||
                                                                 'Unable to Update Record';
                                raise  Some_Error;
                                RETURN;
                END;  
        END  IF;

        p_return_code      :=  0;
        p_return_message   :=  'Updating Tax Type Master is Successful';
        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,'Execution Successful for Maintaining Tax Type Master');
        DBMS_OUTPUT.put_line ('Execution Successful for Maintaining Tax Type Master');

        RETURN;

    EXCEPTION
        WHEN    Some_Error
        THEN    p_return_code    :=  2;
                p_return_message :=  p_return_message || ' - ' ||
                                    'Some error Has Occurred...Existing...Unsuccessful Execution';
                RETURN; 

        WHEN    OTHERS
        THEN    DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                Apex_Util.Set_Session_State('RETURN_MESSAGE' ,p_return_message || ' - ' || SQLERRM);
                APEX_ERROR.add_error ( p_error_code        => p_return_message || ' - ' || SQLERRM,
                                       p0                  => null,
                                       p_display_location  => apex_error.c_inline_with_field_and_notif,
                                       p_page_item_name    => null 
                                     );
                p_return_code    :=  2;
                p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                RETURN;
END     BT_ACD_TAX_TYPE_API;
