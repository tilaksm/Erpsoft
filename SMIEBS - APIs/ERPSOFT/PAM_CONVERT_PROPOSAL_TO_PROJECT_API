---------------------------------------------------------------------------------------------------------------------------------
----    API to Convert Proposal to Project
---------------------------------------------------------------------------------------------------------------------------------
create or replace PROCEDURE PAM_CONVERT_PROPOSAL_TO_PROJECT_API
        (       p_return_code                   OUT     VARCHAR2,
                p_return_message                OUT     VARCHAR2,
                p_project_id                    OUT     NUMBER,
                p_user_id                        IN     NUMBER,
                p_client_id                      IN     NUMBER,
                p_proposal_id                    IN     NUMBER
        )
        AS

----    Declare Variables and Cursors required for generation
        err_message                                     varchar2(200)   := null;
        exists_flag                                     varchar2(01)    := null;
        dummy_flag                                      varchar2(01)    := null;
        recs_added                                      number          := 0;
        v_status_id                                     number          := null;
        v_return_code                                   number          := 0;
        v_return_message                                varchar2(4000)  := null;

----    Declare and Define a Virtual Record for a MRV
        v_project_id                                    number          :=  0;
        v_project_task_id                               number          :=  0;
        v_profit_centre_id                              number          :=  0;
        v_lob_id                                        number          :=  0;
        v_organization_id                               number          :=  0;
        v_client_id                                     number          :=  0;
        v_proposal_id                                   number          :=  0;
        v_proposal_line_id                              number          :=  0;
        v_project_action_id                             number          :=  0;
        fiscal_year_start_date                          date            :=  null;
        fiscal_year_end_date                            date            :=  null;
        v_project_number_prefix                         varchar2(50)    :=  null;
        v_project_number_suffix                         varchar2(50)    :=  null;
        v_project_number                                varchar2(256)   :=  null;

----    Define Exceptions
        Some_Error            EXCEPTION;

----    Define Cusrsor
        CURSOR  GET_PROPOSAL
        IS
                SELECT  sysdate                         status_date                     ,
                        10012                           status_id                       ,
                        null                            project_document_blob           ,
                        null                            directory_name                  ,
                        null                            file_name                       ,
                        null                            mime_type                       ,
                        null                            char_set                        ,
                        null                            file_comments                   ,
                        null                            place_lattitude                 ,
                        null                            place_longitude                 ,
                        null                            place_ip_address                ,
-----                   Project Information
                        proposal_id                     proposal_id                     ,
                        client_id                       client_id                       ,
                        proposal_number                 project_number                  ,
                        proposal_name                   project_Name                    ,
                        Description                     Description                     ,
                        sysdate                         received_date                   ,
-----                   Project Organization information
                        organization_id                 organization_id                 ,
                        lob_id                          lob_id                          ,
                        profit_centre_id                profit_centre_id                ,
                        60201                           transaction_type_id             ,
                        602                             application_id                  ,
-----                   Project Customer Organization information
                        party_id                        party_id                        ,
                        customer_po_number              customer_po_number              ,
                        customer_po_date                customer_po_date                ,
                        bill_to_location_id             bill_to_location_id             ,
                        ship_to_location_id             ship_to_location_id             ,
                        work_to_location_id             work_to_location_id             ,
-----                   Project Classification information
                        proposal_type_set_id            project_type_set_id             ,
                        proposal_type_code_id           project_type_code_id            ,
                        proposal_class_set_id           project_class_set_id            ,
                        proposal_class_code_id          project_class_code_id           ,
-----                   Project Activity information
                        planned_start_date              planned_start_date              ,
                        planned_completion_date         planned_completion_date         ,
                        planned_closed_date             planned_closed_date             ,
                        planned_end_date                planned_end_date                ,
                        planned_end_date                planned_handover_date           ,
                        null                            actual_start_date               ,
                        null                            actual_completion_date          ,
                        null                            actual_closed_Date              ,
                        null                            actual_end_Date                 ,
                        null                            actual_handover_date            ,
                        billing_cycle_set_id            billing_cycle_set_id            ,
                        billing_cycle_code_id           billing_cycle_code_id           ,
-----                   Project Valuation information
                        proposal_quoted_amount          project_cost_amount             ,
                        proposal_taxable_amount         project_revenue_amount          ,
                        proposal_tax_amount             project_tax_amount              ,
                        proposal_total_amount           project_total_amount            ,
                        currency_code                   currency_code                   ,
                        currency_rate                   currency_rate                   ,
                        currency_date                   currency_date                   ,
                        fcnr_proposal_amount            fcnr_project_amount             ,
                        0                               project_budget_amount           ,
                        0                               project_budget_utilized         ,
                        0                               project_billed_amount           ,
                        0                               project_expenses_amount         ,
                        sysdate                         as_on_date                      ,
                        payment_term_id                 payment_term_id                 
                FROM    pam_proposals_all               ppa
                WHERE   1                               =   1
                AND     ( ( not exists
                            ( SELECT    'c'
                              FROM      pam_projects_all     prja
                              WHERE     1                 =   1
                              AND       prja.proposal_id  =   ppa.proposal_id
                              AND       prja.client_id    =   ppa.client_id
                            )
                          )
                        )
                AND     exists
                        (  SELECT       'c'
                           FROM         cmn_status_master       csm
                           WHERE        1               =   1
                           AND          upper(trim(csm.status_code)) in ('WON','OA-GENERATED')
                           AND          csm.status_id   =   ppa.status_id
                           AND          csm.client_id   =   ppa.client_id
                        )
                AND     ppa.proposal_id                   =   p_proposal_id
                AND     ppa.client_id                     =   p_client_id;

        CURSOR  GET_PROPOSAL_LINE
        IS
                SELECT  sysdate                                 creation_date                   ,
----            Standard Who Columns
                        p_user_id                               created_by                      ,
                        sysdate                                 last_update_date                ,
                        p_user_id                               last_updated_by                 ,
                        ppa.received_date                       start_date                      ,
                        null                                    end_date                        ,
-----           Project Task Document and Status Colmn                  
                        10012                                   status_id                       ,
                        sysdate                                 status_date                     ,
                        null                                    task_document_clob              ,
                        null                                    task_document_blob              ,
                        null                                    directory_name                  ,
                        null                                    file_name                       ,
                        null                                    mime_type                       ,
                        null                                    char_set                        ,
                        null                                    file_comments                   ,
                        null                                    place_lattitude                 ,
                        null                                    place_longitude                 ,
                        null                                    place_ip_address                ,
-----           Project Task Information
                        null                                    project_task_id                  ,
                        ppla.proposal_id                        proposal_id                      ,
                        ppla.proposal_line_id                   proposal_line_id                 ,
                        ppla.client_id                          client_id                        ,
                        rownum                                  task_number                      ,
                        ppla.work_item_details                  task_name                        ,
                        ppla.line_subject                       Description                      ,
                        null                                    task_date                        ,
                        ppla.proposal_line_id                   top_task_id                      ,
                        null                                    parent_task_id                   ,
                        null                                    wbs_level                        ,
                        ppla.our_work_item_id                   inventory_item_id                ,
                        'Y'                                     billable_flag                    ,
                        'Y'                                     cost_enabled_flag                ,
                        null                                    service_type_code                ,
                        null                                    task_manager_id                  ,
                        null                                    task_owner_id                    ,
-----           Project Activity information
                        ppa.planned_start_date                  planned_start_date               ,
                        ppa.planned_completion_date             planned_completion_date          ,
                        ppa.planned_closed_date                 planned_closed_date              ,
                        ppa.planned_end_date                    planned_end_date                 ,
                        null                                    planned_days                     ,
                        null                                    actual_start_date                ,
                        null                                    actual_completion_date           ,
                        null                                    actual_closed_Date               ,
                        null                                    actual_end_Date                  ,
                        null                                    actual_days                      ,
                        ppla.quantity                           task_quantity                    ,
                        0                                       task_expenses                    ,
----                        ppla.line_taxable_amount                task_expenses                    ,
                        ppla.line_taxable_amount                task_revenue                     ,
-----           Project Task Classification informatio          
                        null                                    task_type_set_id                 ,
                        null                                    task_type_code_id                ,
                        ppla.product_category                   task_class_set_id                ,
                        ppla.product_sub_category               task_class_code_id               ,
-----           Project Task Valuation information
                        0                                       project_task_cost_amount         ,
                        ppla.line_taxable_amount                project_task_revenue_amount      ,
                        ppla.line_tax_amount                    project_task_tax_amount          ,
                        ppla.line_total_amount                  project_task_total_amount        ,
                        ppa.currency_code                       currency_code                    ,
                        ppa.currency_rate                       currency_rate                    ,
                        ppa.currency_date                       currency_date                    ,
                        0                                       fcnr_project_task_amount         ,
                        ppla.line_taxable_amount                project_task_budget_amount       ,
                        0                                       project_task_budget_utilized     ,
                        0                                       project_task_billed_amount       ,
                        0                                       project_task_expenses_amount     ,
----                        ppla.line_taxable_amount                project_task_expenses_amount     ,
                        ppa.received_date                       as_on_date
                FROM    PAM_PROPOSALS_ALL               ppa,
                        PAM_PROPOSAL_LINES_ALL          ppla
                WHERE   1                               =  1
                AND     ppla.proposal_id                =  ppa.proposal_id
                AND     ppla.client_id                  =  ppa.client_id
                AND     ppa.proposal_id                 =  p_proposal_id
                AND     ppa.client_id                   =  p_client_id;
BEGIN
        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,'Execution Started for Conversion of Proposal to Project');
        DBMS_OUTPUT.put_line ('Execution Started for Conversion of Proposal to Project');

----    Start Validating Input Data
        p_return_code          := 0;                      ----  Successful Execution
        p_return_message       := ' '; 

----    Validate Client / Installation
        IF    (p_client_id is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid Client ';
        END   IF;

        exists_flag  :=  null;
        BEGIN  
                SELECT  'Y'
                INTO    exists_flag
                FROM    cmn_client_master 
                WHERE   1  =  1
                AND     client_id  = p_client_id;
        EXCEPTION
                WHEN    NO_DATA_FOUND
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid Client ID Select No Data Found';
                WHEN    OTHERS
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid Client ID Select Others';
        END;
        p_return_message  := p_return_message ||  ' - '  ||' Client Validated ';
        DBMS_OUTPUT.put_line ('Client Validated. ');

----    Validate User
        IF    (p_user_id is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid User ';
        END   IF;

        exists_flag  :=  null;
        BEGIN  
                SELECT  'Y'
                INTO    exists_flag
                FROM    cmn_user_master 
                WHERE   user_id     = p_user_id
                AND     client_id   = p_client_id;
        EXCEPTION
                WHEN    NO_DATA_FOUND
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid User ID ';
                WHEN    OTHERS
                THEN    p_return_code     := 2;
                        p_return_message  := p_return_message || ' - ' ||
                                             'Invalid User ID ';
        END;
        DBMS_OUTPUT.put_line ('Validated User ID. OK.');

----      Calculate fiscal_year_start and fiscal_year_end_date
          BEGIN 
               SELECT    to_char(to_date('01-APR-'||EXTRACT (YEAR FROM ADD_MONTHS (sysdate, -3)),'DD-MON-YYYY'),'DD-MON-YYYY'),
                         to_char(to_date('31-MAR-'||EXTRACT (YEAR FROM ADD_MONTHS (sysdate,  9)),'DD-MON-YYYY'),'DD-MON-YYYY')
               INTO      fiscal_year_start_date,
                         fiscal_year_end_date
               FROM      DUAL;
          EXCEPTION
               WHEN      OTHERS
               THEN      fiscal_year_start_date  :=  null;
                         fiscal_year_end_date    :=  null;
          END;

----    Validate Proposal Data
        IF    (p_proposal_id is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid Proposal ID ';
        END   IF;
        exists_flag  :=  null;
        BEGIN  
                SELECT  'Y',
                        profit_centre_id,
                        lob_id,
                        organization_id
                INTO    exists_flag,
                        v_profit_centre_id,
                        v_lob_id,
                        v_organization_id
                FROM    pam_proposals_all ppa 
                WHERE   proposal_id = p_proposal_id
                AND     client_id   = p_client_id;
        EXCEPTION
                WHEN    OTHERS
                THEN    null;
        END;
        IF      (exists_flag = 'Y')
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Invalid Proposal ID ';
        END   IF;
        p_return_message  := p_return_message ||  ' - '  ||
                                   'ORganization - LOB - PC ID '||v_organization_id||'-'||v_lob_id||v_profit_centre_id;
        DBMS_OUTPUT.put_line ('Validated Proposal. OK.'||'ORganization - LOB - PC ID '||v_organization_id||'-'||v_lob_id||v_profit_centre_id);

------  Process for Conversion starts
------  Loop out the cursor to build Project Headers
        BEGIN
                FOR     set_projct in GET_PROPOSAL
                LOOP  
------                  First Get the Project_id from Sequence
                        v_project_id  :=    Get_Sequence_ID 
                                        (   p_client_id,
                                            v_organization_id,
                                            v_lob_id,
                                            v_profit_centre_id,
                                            upper('PAM_PROJECTS_ALL')
                                        );
                        IF      ( v_project_id <  0 )
                        THEN      p_return_code     := 2;
                                  p_return_message  := p_return_message ||  ' - '  ||
                                                      'Project ID Can not be Generated..';
                                raise  Some_Error;
                        END IF;
                        p_project_id    :=      v_project_id;

----            Fetching Document Prefix PROJECT NUMBER from CMN_TABLE_SEQUENCES
                BEGIN
                         SELECT    nvl(document_prefix,'PRJ/'),
                                   document_sufix
                         INTO      v_project_number_prefix,
                                   v_project_number_suffix
                         FROM      cmn_table_sequences
                         WHERE     1                        =    1
                         AND       upper(trim(table_name))  =    'PAM_PROJECTS_ALL'
                         AND       sysdate   BETWEEN        nvl(start_date,fiscal_year_start_date)
                                                            AND
                                                            nvl(end_date,fiscal_year_end_date)
                         AND       start_date               is not  null
                         AND       profit_centre_id         =    v_profit_centre_id
                         AND       lob_id                   =    v_lob_id
                         AND       organization_id          =    v_organization_id
                         AND       client_id                =    p_client_id;
                    EXCEPTION
                         WHEN      NO_DATA_FOUND
                         THEN      v_project_number_prefix :=   null;
                                   v_project_number_suffix :=   null;
                         WHEN      OTHERS
                         THEN      v_project_number_prefix :=   null;
                                   v_project_number_suffix :=   null;
                    END;

----            Generating Proposal Number
                v_project_number   :=   v_project_number_prefix||p_project_id||v_project_number_suffix;

-----                   Populate Project Data
                        insert  into  PAM_PROJECTS_ALL
----                    Standard Who Columns       
                                (  creation_date          ,
                                   created_by             ,
                                   last_update_date       ,
                                   last_updated_by        ,
                                   start_date             ,
                                   end_date               ,
-----                   Project Document and Status Colmns
                                   status_id              ,
                                   status_date            ,
                                   project_document_blob  ,
                                   directory_name         ,
                                   file_name              ,
                                   mime_type              ,
                                   char_set               ,
                                   file_comments          ,
                                   place_lattitude        ,
                                   place_longitude        ,
                                   place_ip_address       ,
-----                   Project Information,
                                   project_id             ,
                                   proposal_id            ,
                                   client_id              ,
                                   project_number         ,
                                   project_Name           ,
                                   Description            ,
                                   received_date          ,
-----                   Project Organization information
                                   organization_id        ,
                                   lob_id                 ,
                                   profit_centre_id       ,
                                   transaction_type_id    ,
                                   application_id         ,
-----                   Project Customer Organization information
                                   party_id               ,
                                   customer_po_number     ,
                                   customer_po_date       ,
                                   bill_to_location_id    ,
                                   ship_to_location_id    ,
                                   work_to_location_id    ,
-----                   Project Classification information
                                   project_type_set_id    ,
                                   project_type_code_id   ,
                                   project_class_set_id   ,
                                   project_class_code_id  ,
-----                   Project Activity information
                                   planned_start_date     ,
                                   planned_completion_date,
                                   planned_closed_date    ,
                                   planned_end_date       ,
                                   planned_handover_date  ,
                                   actual_start_date      ,
                                   actual_completion_date ,
                                   actual_closed_Date     ,
                                   actual_end_Date        ,
                                   actual_handover_date   ,
                                   billing_cycle_set_id   ,
                                   billing_cycle_code_id  ,
-----                   Project Valuation information
                                   project_cost_amount    ,
                                   project_revenue_amount ,
                                   project_tax_amount     ,
                                   project_total_amount   ,
                                   currency_code          ,
                                   currency_rate          ,
                                   currency_date          ,
                                   fcnr_project_amount    ,
                                   project_budget_amount  ,
                                   project_budget_utilized,
                                   project_billed_amount  ,
                                   project_expenses_amount,
                                   as_on_date             ,
                                   payment_term_id
                                )
                        VALUES
----                    Standard Who Columns       
                                (  sysdate                              ,
                                   p_user_id                            ,
                                   sysdate                              ,
                                   p_user_id                            ,
                                   set_projct.received_date             ,
                                   null                                 ,
-----                   Project Document and Status Colmns
                                   set_projct.status_id                 ,
                                   set_projct.status_date               ,
                                   set_projct.project_document_blob     ,
                                   set_projct.directory_name            ,
                                   set_projct.file_name                 ,
                                   set_projct.mime_type                 ,
                                   set_projct.char_set                  ,
                                   set_projct.file_comments             ,
                                   set_projct.place_lattitude           ,
                                   set_projct.place_longitude           ,
                                   set_projct.place_ip_address          ,
-----                   Project Information,
                                   v_project_id                         ,
                                   set_projct.proposal_id               ,
                                   set_projct.client_id                 ,
                                   v_project_number                     ,
                                   set_projct.project_Name              ,
                                   set_projct.Description               ,
                                   set_projct.received_date             ,
-----                   Project Organization information
                                   set_projct.organization_id           ,
                                   set_projct.lob_id                    ,
                                   set_projct.profit_centre_id          ,
                                   set_projct.transaction_type_id       ,
                                   set_projct.application_id            ,
-----                   Project Customer Organization information
                                   set_projct.party_id                  ,
                                   set_projct.customer_po_number        ,
                                   set_projct.customer_po_date          ,
                                   set_projct.bill_to_location_id       ,
                                   set_projct.ship_to_location_id       ,
                                   set_projct.work_to_location_id       ,
-----                   Project Classification information
                                   set_projct.project_type_set_id       ,
                                   set_projct.project_type_code_id      ,
                                   set_projct.project_class_set_id      ,
                                   set_projct.project_class_code_id     ,
-----                   Project Activity information
                                   set_projct.planned_start_date        ,
                                   set_projct.planned_completion_date   ,
                                   set_projct.planned_closed_date       ,
                                   set_projct.planned_end_date          ,
                                   set_projct.planned_handover_date     ,
                                   set_projct.actual_start_date         ,
                                   set_projct.actual_completion_date    ,
                                   set_projct.actual_closed_Date        ,
                                   set_projct.actual_end_Date           ,
                                   set_projct.actual_handover_date      ,
                                   set_projct.billing_cycle_set_id      ,
                                   set_projct.billing_cycle_code_id     ,
-----                   Project Valuation information
                                   set_projct.project_cost_amount       ,
                                   set_projct.project_revenue_amount    ,
                                   set_projct.project_tax_amount        ,
                                   set_projct.project_total_amount      ,
                                   set_projct.currency_code             ,
                                   set_projct.currency_rate             ,
                                   set_projct.currency_date             ,
                                   set_projct.fcnr_project_amount       ,
                                   set_projct.project_budget_amount     ,
                                   set_projct.project_budget_utilized   ,
                                   set_projct.project_billed_amount     ,
                                   set_projct.project_expenses_amount   ,
                                   set_projct.as_on_date                ,
                                   set_projct.payment_term_id
                                );
                        commit;
                        IF    (   SET_Sequence_ID 
                                (   p_client_id,
                                        v_organization_id,
                                        v_lob_id,
                                        v_profit_centre_id,
                                        upper('PAM_PROJECTS_ALL'), 
                                        v_project_id
                                )
                                )
                        THEN    commit;
                        ELSE    p_return_code     := 2;
                                p_return_message  := p_return_message ||  ' - '  ||
                                                        'PROJECT ID Sequence Can not be Updated..';
                        END     IF;
                        commit;

----                    Updating Project ID into PAM_ASSOCIATED_DOCUMENTS
                        BEGIN
                                UPDATE  PAM_ASSOCIATED_DOCUMENTS
                                SET
                                        project_id              =       v_project_id,
                                        last_updated_by         =       p_user_id,
                                        last_update_date        =       sysdate
                                WHERE   1                       =       1
                                AND     proposal_id             =       p_proposal_id
                                AND     client_id               =       p_client_id;
                                commit;
                        EXCEPTION
                                WHEN    NO_DATA_FOUND
                                THEN    p_return_code           :=      2;
                                        p_return_message        :=      p_return_message||' - '||'Failed to Update Data in Associated Documents';
                        END;

----                    Updating Project ID into PAM_ASSOCIATED_PARTIES
                        BEGIN
                                UPDATE  PAM_ASSOCIATED_PARTIES
                                SET
                                        project_id              =       v_project_id,
                                        last_updated_by         =       p_user_id,
                                        last_update_date        =       sysdate
                                WHERE   1                       =       1
                                AND     proposal_id             =       p_proposal_id
                                AND     client_id               =       p_client_id;
                                commit;
                        EXCEPTION
                                WHEN    NO_DATA_FOUND
                                THEN    p_return_code           :=      2;
                                        p_return_message        :=      p_return_message||' - '||'Failed to Update Data in Associated Parties';
                        END;

-----                   Create a Project Action
                        PAM_REGISTER_PROJECT_ACTIONS_API 
                        (   p_return_code         =>    p_return_code,
                            p_return_message      =>    p_return_message,
                            p_user_id             =>    p_user_id,
                            p_project_action_id   =>    v_project_action_id,
                            p_project_task_id     =>    null,
                            p_project_id          =>    v_project_id,
                            p_client_id           =>    p_client_id,
                            p_party_id            =>    null,
                            p_lost_to_party_name  =>    null,
                            p_reason_set_id       =>    6010701,
                            p_reason_code_id      =>    601070101,
                            p_action_indicator    =>    'Y',
                            p_action_details      =>    'Project Created for Proposal ID '||p_proposal_id,
                            p_action_amount       =>    set_projct.project_total_amount
                        );
                        commit; 
                        IF      (p_return_code  <>  0)
                        THEN    p_return_message := p_return_message || 'Project Action not Registered '||SQLERRM;
                        END     IF;
                END   LOOP;
        EXCEPTION
            WHEN       OTHERS
            THEN       DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,p_return_message || ' - ' || SQLERRM);
                        APEX_ERROR.add_error ( p_error_code        => p_return_message || ' - ' || SQLERRM,
                                              p0                  => null,
                                              p_display_location  => apex_error.c_inline_with_field_and_notif,
                                              p_page_item_name    => null 
                                            );
                        p_return_code    :=  2;
                        p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                        RETURN;
        END;

------  Now Loop out the cursor to build Project Tasks
        BEGIN
                FOR     set_tasks in GET_PROPOSAL_LINE
                LOOP  
-----                   Generate Project Task ID
                        v_project_task_id  :=   Get_Sequence_ID 
                                                (   p_client_id,
                                                    v_organization_id,
                                                    v_lob_id,
                                                    v_profit_centre_id,
                                                    upper('PAM_PROJECT_TASKS')
                                                );
                        IF      ( v_project_task_id <  0 )
                        THEN      p_return_code     := 2;
                                  p_return_message  := p_return_message ||  ' - '  ||
                                                      'Project Task ID Can not be Generated..';
                                raise  Some_Error;
                        END IF;
-----                   Populate Project Data
                        insert  into  PAM_PROJECT_TASKS
-----                   Standard Who Columns       
                                (       creation_date                ,
                                        created_by                   ,
                                        last_update_date             ,
                                        last_updated_by              ,
                                        start_date                   ,
                                        end_date                     ,
-----                   Project Task Document and Status Colmns
                                        status_id                    ,
                                        status_date                  ,
                                        task_document_clob           ,
                                        task_document_blob           ,
                                        directory_name               ,
                                        file_name                    ,
                                        mime_type                    ,
                                        char_set                     ,
                                        file_comments                ,
                                        place_lattitude              ,
                                        place_longitude              ,
                                        place_ip_address             ,
-----                   Project Task Information
                                        project_task_id              ,
                                        project_id                   ,
                                        proposal_id                  ,
                                        proposal_line_id             ,
                                        client_id                    ,
                                        task_number                  ,
                                        task_name                    ,
                                        Description                  ,
                                        task_date                    ,
                                        top_task_id                  ,
                                        parent_task_id               ,
                                        wbs_level                    ,
                                        inventory_item_id            ,
                                        billable_flag                ,
                                        cost_enabled_flag            ,
                                        service_type_code            ,
                                        task_manager_id              ,
                                        task_owner_id                ,
-----                   Project Activity information
                                        planned_start_date           ,
                                        planned_completion_date      ,
                                        planned_closed_date          ,
                                        planned_end_date             ,
                                        planned_days                 ,
                                        actual_start_date            ,
                                        actual_completion_date       ,
                                        actual_closed_Date           ,
                                        actual_end_Date              ,
                                        actual_days                  ,
                                        task_quantity                ,
                                        task_expenses                ,
                                        task_revenue                 ,
-----                   Project Task Classification information
                                        task_type_set_id             ,
                                        task_type_code_id            ,
                                        task_class_set_id            ,
                                        task_class_code_id           ,
-----                   Project Task Valuation information
                                        project_task_cost_amount     ,
                                        project_task_revenue_amount  ,
                                        project_task_tax_amount      ,
                                        project_task_total_amount    ,
                                        currency_code                ,
                                        currency_rate                ,
                                        currency_date                ,
                                        fcnr_project_task_amount     ,
                                        project_task_budget_amount   ,
                                        project_task_budget_utilized ,
                                        project_task_billed_amount   ,
                                        project_task_expenses_amount ,
                                        as_on_date                   
                                )
                        VALUES
                                (       set_tasks.creation_date                ,
                                        set_tasks.created_by                   ,
                                        set_tasks.last_update_date             ,
                                        set_tasks.last_updated_by              ,
                                        set_tasks.start_date                   ,
                                        set_tasks.end_date                     ,
-----                   Project Task Document and Status Colmns
                                        set_tasks.status_id                    ,
                                        set_tasks.status_date                  ,
                                        set_tasks.task_document_clob           ,
                                        set_tasks.task_document_blob           ,
                                        set_tasks.directory_name               ,
                                        set_tasks.file_name                    ,
                                        set_tasks.mime_type                    ,
                                        set_tasks.char_set                     ,
                                        set_tasks.file_comments                ,
                                        set_tasks.place_lattitude              ,
                                        set_tasks.place_longitude              ,
                                        set_tasks.place_ip_address             ,
-----                   Project Task Information
                                        v_project_task_id                      ,
                                        v_project_id                           ,
                                        set_tasks.proposal_id                  ,
                                        set_tasks.proposal_line_id             ,
                                        set_tasks.client_id                    ,
                                        set_tasks.task_number                  ,
                                        set_tasks.task_name                    ,
                                        set_tasks.Description                  ,
                                        nvl(set_tasks.task_date,sysdate)       ,
                                        set_tasks.proposal_line_id             ,
                                        v_project_task_id                      ,
                                        1                                      ,
                                        set_tasks.inventory_item_id            ,
                                        set_tasks.billable_flag                ,
                                        set_tasks.cost_enabled_flag            ,
                                        set_tasks.service_type_code            ,
                                        set_tasks.task_manager_id              ,
                                        set_tasks.task_owner_id                ,
-----                   Project Activity information
                                        set_tasks.planned_start_date           ,
                                        set_tasks.planned_completion_date      ,
                                        set_tasks.planned_closed_date          ,
                                        set_tasks.planned_end_date             ,
                                        set_tasks.planned_days                 ,
                                        set_tasks.actual_start_date            ,
                                        set_tasks.actual_completion_date       ,
                                        set_tasks.actual_closed_Date           ,
                                        set_tasks.actual_end_Date              ,
                                        set_tasks.actual_days                  ,
                                        set_tasks.task_quantity                ,
                                        set_tasks.task_expenses                ,
                                        set_tasks.task_revenue                 ,
-----                   Project Task Classification information
                                        set_tasks.task_type_set_id             ,
                                        set_tasks.task_type_code_id            ,
                                        set_tasks.task_class_set_id            ,
                                        set_tasks.task_class_code_id           ,
-----                   Project Task Valuation information
                                        set_tasks.project_task_cost_amount     ,
                                        set_tasks.project_task_revenue_amount  ,
                                        set_tasks.project_task_tax_amount      ,
                                        set_tasks.project_task_total_amount    ,
                                        set_tasks.currency_code                ,
                                        set_tasks.currency_rate                ,
                                        set_tasks.currency_date                ,
                                        set_tasks.fcnr_project_task_amount     ,
                                        set_tasks.project_task_budget_amount   ,
                                        set_tasks.project_task_budget_utilized ,
                                        set_tasks.project_task_billed_amount   ,
                                        set_tasks.project_task_expenses_amount ,
                                        set_tasks.as_on_date                   
                                );
                        commit;
                        IF      (   SET_Sequence_ID 
                                    (   p_client_id,
                                        v_organization_id,
                                        v_lob_id,
                                        v_profit_centre_id,
                                        upper('PAM_PROJECT_TASKS'), 
                                        v_project_task_id
                                    )
                                )
                        THEN    commit;
                        ELSE    p_return_code     := 2;
                                p_return_message  := p_return_message ||  ' - '  ||
                                                        'PROJECT ID Sequence Can not be Updated..';
                        END     IF;
                        commit;

-----                   Update PAM_BILL_OF_QUANTITY for the Project ID
                        UPDATE  PAM_BILL_OF_QUANTITY
                        SET     last_updated_by         =       p_user_id,
                                last_update_date        =       sysdate,
                                project_id              =       v_project_id,
                                project_task_id         =       v_project_task_id
                        WHERE   1                       =       1
                        AND     proposal_line_id        =       set_tasks.proposal_line_id 
                        AND     proposal_id             =       p_proposal_id
                        AND     client_id               =       p_client_id;

----                    Updating Project ID into PAM_ASSOCIATED_DOCUMENTS
                        BEGIN
                                UPDATE  PAM_ASSOCIATED_DOCUMENTS
                                SET
                                        project_id              =       v_project_id,
                                        project_task_id         =       v_project_task_id,
                                        last_updated_by         =       p_user_id,
                                        last_update_date        =       sysdate
                                WHERE   1                       =       1
                                AND     proposal_line_id        =       set_tasks.proposal_line_id
                                AND     proposal_id             =       p_proposal_id
                                AND     client_id               =       p_client_id;
                                commit;
                        EXCEPTION
                                WHEN    NO_DATA_FOUND
                                THEN    p_return_code           :=      2;
                                        p_return_message        :=      p_return_message||' - '||'Failed to Update Data in Associated Documents';
                        END;

----                    Updating Project ID into PAM_ASSOCIATED_PARTIES
                        BEGIN
                                UPDATE  PAM_ASSOCIATED_PARTIES
                                SET
                                        project_id              =       v_project_id,
                                        project_task_id         =       v_project_task_id,
                                        last_updated_by         =       p_user_id,
                                        last_update_date        =       sysdate
                                WHERE   1                       =       1
                                AND     proposal_line_id        =       set_tasks.proposal_line_id
                                AND     proposal_id             =       p_proposal_id
                                AND     client_id               =       p_client_id;
                                commit;
                        EXCEPTION
                                WHEN    NO_DATA_FOUND
                                THEN    p_return_code           :=      2;
                                        p_return_message        :=      p_return_message||' - '||'Failed to Update Data in Associated Parties';
                        END;

-----                   Create a Project Action
                        PAM_REGISTER_PROJECT_ACTIONS_API 
                        (   p_return_code         =>    p_return_code,
                            p_return_message      =>    p_return_message,
                            p_user_id             =>    p_user_id,
                            p_project_action_id   =>    v_project_action_id,
                            p_project_task_id     =>    v_project_task_id,
                            p_project_id          =>    v_project_id,
                            p_client_id           =>    p_client_id,
                            p_party_id            =>    null,
                            p_lost_to_party_name  =>    null,
                            p_reason_set_id       =>    6010702,
                            p_reason_code_id      =>    601070205,
                            p_action_indicator    =>    'Y',
                            p_action_details      =>    'Project Task Created for Project Task ID '||v_project_task_id,
                            p_action_amount       =>    set_tasks.project_task_total_amount
                        );
                        commit; 
                        IF      (p_return_code  <>  0)
                        THEN    p_return_message := p_return_message || 'Project Task Action not Registered '||SQLERRM;
                        END     IF;
                END   LOOP;

-----           Update PAM_BILL_OF_QUANTITY for the Project ID
                UPDATE  PAM_BILL_OF_QUANTITY
                SET     last_updated_by         =       p_user_id,
                        last_update_date        =       sysdate,
                        project_id              =       v_project_id
                WHERE   1                       =       1
                AND     proposal_id             =       p_proposal_id
                AND     client_id               =       p_client_id;
                commit;

        EXCEPTION
            WHEN       OTHERS
            THEN       DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,p_return_message || ' - ' || SQLERRM);
                        APEX_ERROR.add_error ( p_error_code        => p_return_message || ' - ' || SQLERRM,
                                              p0                  => null,
                                              p_display_location  => apex_error.c_inline_with_field_and_notif,
                                              p_page_item_name    => null 
                                            );
                        p_return_code    :=  2;
                        p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                        RETURN;
        END;

        commit;
        p_return_code      :=  0;
        p_return_message   :=  'Proposal To Project Conversion is Successful';
        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,'Proposal To Project Conversion is Successful');
        DBMS_OUTPUT.put_line ('Proposal To Project Conversion is Successful');
        RETURN;
EXCEPTION
     WHEN       Some_Error
     THEN       DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                Apex_Util.Set_Session_State('RETURN_MESSAGE' ,p_return_message || ' - ' || SQLERRM);
                APEX_ERROR.add_error ( p_error_code        => p_return_message || ' - ' || SQLERRM,
                                      p0                  => null,
                                      p_display_location  => apex_error.c_inline_with_field_and_notif,
                                      p_page_item_name    => null 
                                    );
                p_return_code    :=  2;
                p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                RETURN;
    WHEN        OTHERS
    THEN        DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                Apex_Util.Set_Session_State('RETURN_MESSAGE' ,p_return_message || ' - ' || SQLERRM);
                APEX_ERROR.add_error ( p_error_code        => p_return_message || ' - ' || SQLERRM,
                                       p0                  => null,
                                       p_display_location  => apex_error.c_inline_with_field_and_notif,
                                       p_page_item_name    => null 
                                     );
                p_return_code    :=  2;
                p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                RETURN;
END     PAM_Convert_Proposal_To_Project_API;
