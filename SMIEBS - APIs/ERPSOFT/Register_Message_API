create or replace PROCEDURE           "REGISTER_MESSAGE_API" 
        (     p_return_code                     OUT VARCHAR2,
              p_return_message                  OUT VARCHAR2,
              p_action                          IN  VARCHAR2,
              p_user_id                         IN  NUMBER,
              -- p_start_date                      IN  DATE,
              -- p_end_date                        IN  DATE,
              p_client_id                       IN  NUMBER,
              p_communication_id                IN  NUMBER,
              p_parent_communication_id         IN  NUMBER,
              p_communication_number            IN  VARCHAR2,
              p_communication_date              IN  DATE,
              p_details                         IN  VARCHAR2,
              p_type_set_id                     IN  NUMBER,
              p_type_code_id                    IN  NUMBER,
              p_category_id                     IN  NUMBER,
              p_sub_category_id                 IN  NUMBER,
              p_due_date                        IN  DATE,
              p_expiry_date                     IN  DATE,
              p_group_id                        IN  NUMBER,
              p_from_party_id                   IN  NUMBER,
              p_to_party_id                     IN  NUMBER
        )

        AS

----    Declare Variables and Cursors required for generation
        err_message           varchar2(200) := null;
        exists_flag           varchar2(01)  := null;
        dummy_flag            varchar2(01)  := null;
        recs_added            number        := 0;
        v_communication_id    number        := 0;

----    Define Exceptions
        Some_Error            EXCEPTION;

BEGIN

----    Start of Registration
        p_return_code          := 0;                ----  Successful Execution
        p_return_message       := ' ';

----    Validate Client ID
        BEGIN  
                SELECT  'Y'
                INTO    exists_flag
                FROM    cmn_client_master
                WHERE   client_id            =  p_client_id;
        EXCEPTION
                WHEN    NO_DATA_FOUND
                THEN    p_return_code       := 2;
                        p_return_message    := p_return_message || ' - ' ||
                                                'Invalid Client ID Passed';
                WHEN    OTHERS
                THEN    p_return_code       :=  2;
                        p_return_message    :=  p_return_message || ' - ' ||
                                               'Invalid Client ID Passed';
        END;

----    Validate Parent Communication ID
        IF      ( p_parent_communication_id is not null)
        THEN
                BEGIN  
                        SELECT  'Y'
                        INTO    exists_flag
                        FROM    cmn_communications
                        WHERE   communication_id         =  p_parent_communication_id
                        AND     client_id                =  p_client_id;
                EXCEPTION
                WHEN            NO_DATA_FOUND
                THEN            p_return_code           :=  2;
                                p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Parent Communication ID Passed';
                WHEN            OTHERS
                THEN            p_return_code           :=  2;
                                p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Parent Communication ID Passed';
                END;
        END     IF;

----    Validate Communication Date
        IF    (p_communication_date is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Communication Date must have some value.';
        END   IF;

----    Validate Details
        IF    (p_details is null)
        THEN  p_return_code     := 2;
              p_return_message  := p_return_message ||  ' - '  ||
                                   'Details must have some value.';
        END   IF;

----    Validate Type Set ID
        IF      (p_type_set_id is not null)
        THEN
                BEGIN  
                        SELECT  'Y'
                        INTO    exists_flag
                        FROM    cmn_lookup_sets_master
                        WHERE   lookup_set_id            =  p_type_set_id
                        AND     upper(lookup_set_code)   =  'COMMUNICATION_SET';                                          
                EXCEPTION
                WHEN            NO_DATA_FOUND
                THEN            p_return_code           :=  2;
                                p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Type Set ID Passed';
                WHEN            OTHERS
                THEN            p_return_code           :=  2;
                                p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Type Set ID Passed';
                END;
        END     IF;

----    Validate Type Code ID
        IF      ((p_type_set_id is not  null)  AND  (p_type_code_id is null))
        THEN    p_return_code     := 2;
                p_return_message  := p_return_message ||  ' - '  ||
                                    'Incorrect Type Set or Code ID.';
        END     IF;

        IF      ( p_type_code_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_lookup_codes_master
                    WHERE   lookup_set_id            =  p_type_set_id
                    AND     lookup_code_id           =  p_type_code_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Type Code ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Type Code ID Passed';
                END;
        END     IF;

----    Validate Category ID
        IF      (p_category_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_category_master
                    WHERE   category_id              =  p_category_id
                    AND     client_id                =  p_client_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Category ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Category ID Passed';
                END;
        END     IF;

----    Validate Sub Category ID
        IF      ((p_category_id is not  null)  AND  (p_sub_category_id is null))
        THEN    p_return_code     := 2;
                p_return_message  := p_return_message ||  ' - '  ||
                                    'Incorrect Category or Subcategory ID.';
        END     IF;

        IF      (p_sub_category_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_sub_category_master
                    WHERE   sub_category_id          =  p_sub_category_id
                    AND     client_id                =  p_client_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Sub Category ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid Sub Category ID Passed';
                END;
        END     IF;

----    Validate Group ID
        IF      (p_group_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_people_groups_v
                    WHERE   group_id                             =  p_group_id
                    AND     trim(upper(group_type_code))         = 'COMMUNICATIONS'
                    AND     trim(upper(group_type_set_code))     = 'PEOPLE_GROUP_TYPES'
                    AND     client_id                            =  p_client_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code                       :=  2;
                            p_return_message                    :=  p_return_message || ' - ' ||
                                                                   'Invalid Group ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code                       :=  2;
                            p_return_message                    :=  p_return_message || ' - ' ||
                                                                    'Invalid Group ID Passed';
                END;
        END     IF;    

----    Validate From Party ID
        IF      (p_from_party_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_party_master
                    WHERE   party_id                 =  p_from_party_id
                    AND     client_id                =  p_client_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid From Party ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid From Party ID Passed';
                END;
        END     IF;  

----    Validate To Party ID
        IF      (p_to_party_id is not null)
        THEN
                BEGIN  
                    SELECT  'Y'
                    INTO    exists_flag
                    FROM    cmn_party_master
                    WHERE   party_id                 =  p_to_party_id
                    AND     client_id                =  p_client_id;                                          
                EXCEPTION
                    WHEN    NO_DATA_FOUND
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid To Party ID Passed';
                    WHEN    OTHERS
                    THEN    p_return_code           :=  2;
                            p_return_message        :=  p_return_message || ' - ' ||
                                                        'Invalid To Party ID Passed';
                END;
        END     IF;  

----    Verify if thre is an error, if yes then raise exception and exit out
        IF    ( p_return_code <> 0)
        THEN  raise  Some_Error;
        END   IF;

----    Take Action according to p_action variable
        BEGIN
            v_communication_id := cmn_communications_seq.nextval;

            INSERT INTO cmn_communications
            (   CREATION_DATE,
                CREATED_BY,
                LAST_UPDATE_DATE,
                LAST_UPDATED_BY,
                START_DATE,
                END_DATE,
                CLIENT_ID,
                COMMUNICATION_ID,
                PARENT_COMMUNICATION_ID,    
                COMMUNICATION_NUMBER,
                COMMUNICATION_DATE,
                DETAILS,
                TYPE_SET_ID,
                TYPE_CODE_ID,
                CATEGORY_ID,
                SUB_CATEGORY_ID,
                DUE_DATE,
                EXPIRY_DATE,
                GROUP_ID,
                FROM_PARTY_ID,
                TO_PARTY_ID
            )
            VALUES
            (   sysdate,
                p_user_id,
                sysdate,
                p_user_id,
                sysdate,
                null,
                p_client_id,
                v_communication_id,
                p_parent_communication_id,
                v_communication_id,
                p_communication_date,
                p_details,
                p_type_set_id,
                p_type_code_id,
                p_category_id,
                p_sub_category_id,
                p_due_date,
                nvl(p_due_date,sysdate),
                p_group_id,
                p_from_party_id,
                p_to_party_id
            );
            commit;
        EXCEPTION  
            WHEN    OTHERS
            THEN    p_return_code      :=  2;
                    p_return_message   :=  p_return_message ||  ' - '  ||
                                           'Unable to create Record' || SQLERRM;
                    raise  Some_Error;
                    RETURN;

        END;

        p_return_code      :=  0;
        p_return_message   :=  'Message Registration is Successful';
        Apex_Util.Set_Session_State('RETURN_MESSAGE' ,'Message Registration is Successful');
        DBMS_OUTPUT.put_line ('Message Registration is Successful');

        RETURN;

    EXCEPTION
        WHEN    Some_Error
        THEN    p_return_code    :=  2;
                p_return_message :=  p_return_message || ' - ' ||
                                    'Some error Has Occurred...Existing...Unsuccessful Execution' || SQLERRM;
                RETURN; 

        WHEN    OTHERS
        THEN    DBMS_OUTPUT.put_line (p_return_message || ' - ' || SQLERRM);
                Apex_Util.Set_Session_State('RETURN_MESSAGE' , p_return_message || ' - ' || SQLERRM);
                APEX_ERROR.add_error ( p_error_code         => p_return_message || ' - ' || SQLERRM,
                                       p0                   => null,
                                       p_display_location   => apex_error.c_inline_with_field_and_notif,
                                       p_page_item_name     => null 
                                     );
                p_return_code    :=  2;
                p_return_message :=  p_return_message ||  ' - ' || SQLERRM;
                RETURN;
END;