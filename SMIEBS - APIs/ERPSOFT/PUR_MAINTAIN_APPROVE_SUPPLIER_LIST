create or replace PROCEDURE           "PUR_MAINTAIN_APPROVED_SUPPLIER_LIST_API" 
(
          i_return_message              OUT  VARCHAR2,
          i_return_code                 OUT  NUMBER,
          i_action                      IN   VARCHAR2,
          i_user_id                     IN   NUMBER,
          i_client_id                   IN   NUMBER,
          i_lob_id                      IN   NUMBER,
          i_organization_id             IN   NUMBER,
          i_profit_centre_id            IN   NUMBER,

          i_asl_id                      IN   OUT  NUMBER,
          i_party_id                    IN   NUMBER,
          i_inventory_item_id           IN   NUMBER,
          i_priority_id                 IN   NUMBER,
          i_business_share              IN   NUMBER,
          i_min_po_qty_to_place         IN   NUMBER,      
          i_max_po_qty_to_place         IN   NUMBER,  
          i_review_frequency            IN   NUMBER,  
          i_last_review_date            IN   DATE, 
          i_next_review_date            IN   DATE,  
          i_last_review_by_party_id     IN   NUMBER,
          i_created_by_party_id         IN   NUMBER,  
          i_remarks                     IN   CLOB,
          i_start_date                  IN   DATE,
          i_end_date                    IN   DATE,
          i_price_list_id               IN   NUMBER,
          i_price_list_line_id          IN   NUMBER
)

AS
----      Declare Variables and Cursors required for Data Generation
          err_message                   varchar2(200)  :=   null                          ;
          exists_flag                   varchar2(50)   :=   null                          ;
          v_transaction_type_id         number         :=   null                          ;
          v_status_id                   number         :=   1002                          ;
          v_status_date                 date           :=   sysdate                       ;

          v_user_id                     number         :=   i_user_id                     ;
          v_client_id                   number         :=   i_client_id                   ;
          v_lob_id                      number         :=   i_lob_id                      ;
          v_organization_id             number         :=   i_organization_id             ;
          v_profit_centre_id            number         :=   i_profit_centre_id            ;
          v_asl_id                      number         :=   i_asl_id                      ;
          v_party_id                    number         :=   i_party_id                    ;
          v_inventory_item_id           number         :=   i_inventory_item_id           ;
          v_priority_id                 number         :=   i_priority_id                 ;
          v_business_share              number         :=   i_business_share              ;
          v_min_po_qty_to_place         number         :=   i_min_po_qty_to_place         ;
          v_max_po_qty_to_place         number         :=   i_max_po_qty_to_place         ;
          v_review_frequency            number         :=   i_review_frequency            ;
          v_last_review_date            date           :=   i_last_review_date            ;
          v_next_review_date            date           :=   i_next_review_date            ;
          v_last_review_by_party_id     number         :=   i_last_review_by_party_id     ;
          v_created_by_party_id         number         :=   i_created_by_party_id         ;
          v_remarks                     clob           :=   i_remarks                     ;
          v_start_date                  date           :=   i_start_date                  ;
          v_end_date                    date           :=   i_end_date                    ;
          v_price_list_id               number         :=   i_price_list_id               ;
          v_price_list_line_id          number         :=   i_price_list_line_id          ;

          Some_Error                                        EXCEPTION                     ;

BEGIN
----      Validate Client ID
          exists_flag    :=   null;
          BEGIN
               SELECT    'Y',
                         client_id
               INTO      exists_flag,
                         v_client_id
               FROM      CMN_CLIENT_MASTER
               WHERE     CLIENT_ID           =    i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       :=   2;
                         i_return_message    :=   i_return_message||' - '||'Invalid Client ID';
               WHEN      OTHERS
               THEN      i_return_code       :=   2;
                         i_return_message    :=   i_return_message||' - '||'Invalid Client ID';
          END;

----      Validate Organization ID
          exists_flag   :=  null;
          BEGIN
               SELECT    'Y',
                         organization_id
               INTO      exists_flag,
                         v_organization_id
               FROM      CMN_ORGANIZATION_MASTER
               WHERE     1                   =   1
               AND       ORGANIZATION_ID     =   i_organization_id
               AND       CLIENT_ID           =   i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Organization ID';
               WHEN      OTHERS
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Organization ID';
          END;

----      Validate LOB ID
          exists_flag := null;
          BEGIN
               SELECT    'Y',
                         lob_id
               INTO      exists_flag,
                         v_lob_id
               FROM      CMN_LOB_MASTER
               WHERE     1                   =   1
               AND       LOB_ID              =   i_lob_id
               AND       ORGANIZATION_ID     =   i_organization_id
               AND       CLIENT_ID           =   i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid LOB ID';
               WHEN      OTHERS
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid LOB ID';
        END;

----      Validate Profit Centre ID
          exists_flag    :=   null;
          BEGIN
               SELECT    'Y',
                         profit_centre_id
               INTO      exists_flag,
                         v_profit_centre_id
               FROM      CMN_PROFIT_CENTRE_MASTER
               WHERE     1                   =   1
               AND       ORGANIZATION_ID     =   i_organization_id
               AND       LOB_ID              =   i_lob_id
               AND       PROFIT_CENTRE_ID    =   i_profit_centre_id
               AND       CLIENT_ID           =   i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Profit Centre ID';
               WHEN      OTHERS
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Profit Centre ID';
          END;

----      Populate Default Value for Transaction Type ID
          BEGIN
               SELECT    transaction_type_id
               INTO      v_transaction_type_id
               FROM      cmn_transaction_types 
               WHERE     1                                       =    1
               AND       upper(trim(transaction_type_code))      =    'MANAGE_PO_HEADERS'
               AND       application_id                          =    801
               AND       client_id                               =    i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      v_transaction_type_id   :=  80111;
               WHEN      OTHERS
               THEN      v_transaction_type_id   :=  80111;
          END;

----      Populate Default Value for Status ID
          BEGIN
               SELECT    status_id
               INTO      v_status_id
               FROM      cmn_status_master
               WHERE     1                             =    1
               AND       upper(TRIM(STATUS_CODE))      =    'OPEN'
               AND       client_id                     =    i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      v_status_id   :=  10002;
               WHEN      OTHERS
               THEN      v_status_id   :=  10002;
          END;

----      Validate Party ID
          IF(i_party_id is null)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'Please select Party';
          ELSE
          exists_flag    :=   null;
          BEGIN
               SELECT    'Y',
                         party_id
               INTO      exists_flag,
                         v_party_id
               FROM      cmn_vendor_master_v
               WHERE     1                             =    1
               AND       party_id                      =    i_party_id
               AND       client_id                     =    i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Party ID';
               WHEN      OTHERS
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Party ID';
          END;
          END IF;

----      Validate Party ID, already exists
          IF(i_party_id is null)
          THEN
          exists_flag    :=   null;
          BEGIN
               SELECT    party_id
               INTO      exists_flag
               FROM      pur_approved_supplier_list
               WHERE     1                             =    1
               AND       party_id                      =    i_party_id
               AND       profit_centre_id              =    i_profit_centre_id
               AND       lob_id                        =    i_lob_id
               AND       organization_id               =    i_organization_id
               AND       client_id                     =    i_client_id;
               IF(exists_flag = i_party_id)
               THEN i_return_code       :=   2;   
                    i_return_message    :=   i_return_message||' - '||'Party Already Exists';
               END IF;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      exists_flag := NULL;
           END;
      END IF;

----      Validate Inventory Item ID
          IF(i_inventory_item_id is null)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'Please select Inventory Item';
          ELSE
          exists_flag    :=   null;
          BEGIN
               SELECT    'Y',
                         inventory_item_id
               INTO      exists_flag,
                         v_inventory_item_id
               FROM      CMN_PRICE_LIST_LINES_V
               WHERE     1                   =    1
               AND       INVENTORY_ITEM_ID   =    i_inventory_item_id
               AND       price_list_id       =    i_price_list_id
               AND       PARTY_ID            =    i_party_id
               AND       profit_centre_id    =    i_profit_centre_id
               AND       lob_id              =    i_lob_id
               AND       organization_id     =    i_organization_id
               AND       CLIENT_ID           =    i_client_id;
               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Inventory Item-NO DATA';
               WHEN      OTHERS
               THEN      i_return_code       := 2;
                         i_return_message    := i_return_message||' - '||'Invalid Inventory Item'||SQLERRM;
          END;
          END IF;

----      Validate Inventory Item ID, already exists
          IF(i_action='I')
          THEN
          exists_flag    :=   null;
          BEGIN
               SELECT    'Y'
               INTO      exists_flag
               FROM      pur_approved_supplier_list
               WHERE     1                   =    1
               AND       inventory_item_id   =    i_inventory_item_id
               AND       party_id            =    i_party_id
               AND       profit_centre_id    =    i_profit_centre_id
               AND       lob_id              =    i_lob_id
               AND       organization_id     =    i_organization_id
               AND       CLIENT_ID           =    i_client_id;

               IF(exists_flag = 'Y')
               THEN i_return_code       :=   2;   
                    i_return_message    :=   i_return_message||' - '||'Inventory Item Already Exists for this Party';
               END IF;

               EXCEPTION
               WHEN      NO_DATA_FOUND
               THEN      exists_flag := NULL;
          END;
          END IF;

----      Validate Last Review By Party ID
          -- IF(i_last_review_by_party_id is null)
          -- THEN i_return_code       :=   2;
          --      i_return_message    :=   i_return_message||' - '||'Please select Last Review By Party';
          -- ELSE
          -- exists_flag    :=   null;
          -- BEGIN
          --      SELECT    'Y'
          --      INTO      exists_flag
          --      FROM      CMN_EMPLOYEE_MASTER_V
          --      WHERE     1                   =    1
          --      AND       EMPLOYEE_ID         =    i_last_review_by_party_id
          --      AND       CLIENT_ID           =    i_client_id;
          --      EXCEPTION
          --      WHEN      NO_DATA_FOUND
          --      THEN      i_return_code       := 2;
          --                i_return_message    := i_return_message||' - '||'Invalid Last Review By Party';
          --      WHEN      OTHERS
          --      THEN      i_return_code       := 2;
          --                i_return_message    := i_return_message||' - '||'Invalid Last Review By Party';
          -- END;
          -- END IF;

----      Validate Priority ID
          IF(i_priority_id < 1 OR i_priority_id > 99)  
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'Priority ID should be between 01 to 99';
          END IF;

----      Validate Business Share
          IF(i_business_share < 1 OR i_business_share > 100)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'Business Share should be between 01 to 100';
          END IF;

----      Validate Minimum PO Quantity
          IF(i_min_po_qty_to_place <= 0)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'Minimum quantity To Place should be greater than Zero';
          END IF;

----      Validate End Date
          IF(i_end_date < i_start_date)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'End Date should be greater than '||i_start_date;
          END IF;

----      Checking if there is any error, if return code is =! 0 then it will raise error
          IF    (i_return_code <> 0)
          THEN  raise  Some_Error;
          END IF;

----      Action
          CASE upper(i_action)
          WHEN 'I'  THEN NULL;
          WHEN 'A'  THEN NULL;
          WHEN 'C'  THEN NULL;
          WHEN 'U'  THEN NULL;
          ELSE i_return_code       :=   2;
               i_return_message    :=   'Invalid Action Passed'||' - '||i_action;
          END CASE;

----      Checking Action
          IF(UPPER(i_action)IN('I','A','C'))
          THEN

          i_asl_id  :=   Get_Sequence_ID
                         (
                              i_client_id,
                              i_organization_id,
                              i_lob_id,
                              i_profit_centre_id,
                              UPPER('PUR_APPROVED_SUPPLIER_LIST')
                         );
                         COMMIT;

          IF(i_asl_id < 0)
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message||' - '||'ASL ID Cannot be Generated';
               raise     Some_Error;
          END IF;

          BEGIN
               INSERT INTO    PUR_APPROVED_SUPPLIER_LIST
               (
                    creation_date,
                    created_by,
                    last_update_date,
                    last_updated_by,
                    start_date,
                    end_date,

                    status_id,          
                    status_date,      
                    asl_document,
                    directory_name,
                    file_name,
                    mime_type,
                    char_set,
                    file_comments,
                    transaction_type_id,
                    place_lattitude,
                    place_longitude,
                    place_ip_address,

                    asl_id,                  
                    client_id,               
                    organization_id,         
                    lob_id,                  
                    profit_centre_id,        
                    party_id,                
                    inventory_item_id,       
                    priority_id,             
                    business_share,          
                    min_po_qty_to_place,     
                    max_po_qty_to_place,     
                    review_frequency,        
                    last_review_date,        
                    next_review_date,        
                    last_review_by_party_id,
                    created_by_party_id,
                    remarks,
                    price_list_id                 
               )
               VALUES
               (
                    sysdate,                      ---- creation_date
                    v_user_id,                    ---- created_by
                    sysdate,                      ---- last_update_date
                    v_user_id,                    ---- last_updated_by
                    sysdate,                      ---- start_date
                    null,                         ---- end_date

                    v_status_id,          
                    sysdate,                      ---- status_date      
                    null,                         ---- asl_document
                    null,                         ---- directory_name
                    null,                         ---- file_name
                    null,                         ---- mime_type
                    null,                         ---- char_set
                    null,                         ---- file_comments
                    v_transaction_type_id,
                    null,                         ---- place_lattitude
                    null,                         ---- place_longitude
                    null,                         ---- place_ip_address

                    i_asl_id,                  
                    v_client_id,               
                    v_organization_id,         
                    v_lob_id,                  
                    v_profit_centre_id,        
                    v_party_id,                
                    v_inventory_item_id,       
                    v_priority_id,             
                    v_business_share,          
                    v_min_po_qty_to_place,     
                    v_max_po_qty_to_place,     
                    v_review_frequency,        
                    v_last_review_date,        
                    v_next_review_date,        
                    v_last_review_by_party_id,
                    v_created_by_party_id,
                    v_remarks,
                    v_price_list_id  
               );
               COMMIT;

----      Setting Sequence ID
          IF(SET_Sequence_ID
          (
               i_client_id,
               i_organization_id,
               i_lob_id,
               i_profit_centre_id,
               upper('PUR_APPROVED_SUPPLIER_LIST'),
               i_asl_id
          ))
          THEN COMMIT;
          ELSE i_return_code       :=   2;
               i_return_message    :=   i_return_message ||' - '|| 'ASL ID Sequence Cannot be Updated';
          END IF;

          EXCEPTION
          WHEN OTHERS
          THEN i_return_code       :=   2;
               i_return_message    :=   i_return_message ||' - '|| 'Unable to Create Approved Supplier' || SQLERRM;
               raise     Some_Error;
          RETURN;

          END;

          i_return_code       :=   0;
          i_return_message    :=   'Purchase Approved Supplier Created Successfully';
          Apex_Util.Set_Session_State('LOGIN_MESSAGE' ,'Purchase Approved Supplier Created Successfully');
          DBMS_OUTPUT.put_line ('Purchase Approved Supplier Created Successfully');
          RETURN;

          ELSE
          BEGIN
               UPDATE    PUR_APPROVED_SUPPLIER_LIST
               SET
                         last_update_date              =    sysdate,
                         last_updated_by               =    v_user_id,
                         end_date                      =    v_end_date,

                         priority_id                   =    v_priority_id,              
                         business_share                =    v_business_share,           
                         min_po_qty_to_place           =    v_min_po_qty_to_place,      
                         max_po_qty_to_place           =    v_max_po_qty_to_place,      
                         review_frequency              =    v_review_frequency,         
                         last_review_date              =    v_last_review_date,         
                         next_review_date              =    v_next_review_date,         
                         last_review_by_party_id       =    v_last_review_by_party_id,
                         created_by_party_id           =    v_created_by_party_id,
                         remarks                       =    v_remarks
               WHERE     ASL_ID                        =    i_asl_id
               AND       PROFIT_CENTRE_ID              =    i_profit_centre_id
               AND       LOB_ID                        =    i_lob_id
               AND       ORGANIZATION_ID               =    i_organization_id
               AND       CLIENT_ID                     =    i_client_id;
               COMMIT;

               EXCEPTION
               WHEN OTHERS
               THEN i_return_code       :=   2;
                    i_return_message    :=   i_return_message ||' - '|| 'Unable to Update Approved Supplier' || SQLERRM;
                    raise     Some_Error;
               RETURN;

          END;

          END IF;

          i_return_code       :=   0;
          i_return_message    :=   'Purchase Approved Supplier Updated Successfully';
          Apex_Util.Set_Session_State('LOGIN_MESSAGE' ,'Purchase Approved Supplier Updated Successfully');
          DBMS_OUTPUT.put_line ('Purchase Approved Supplier Updated Successfully');
          RETURN;

----      If any system error occurs, this Exception Block will get Execute 
          EXCEPTION
          WHEN Some_Error
          THEN i_return_code       := 2;
               i_return_message    := i_return_message ||' - '|| 'Some Error Occurred';
          RETURN;

          WHEN OTHERS
          THEN DBMS_OUTPUT.put_line (i_return_message ||' - '|| SQLERRM);
          Apex_Util.Set_Session_State('LOGIN_MESSAGE',i_return_message ||' - '|| SQLERRM);
          i_return_code           := 2;
          i_return_message        := i_return_message ||' - '|| SQLERRM;
          RETURN;

END PUR_MAINTAIN_APPROVED_SUPPLIER_LIST_API;